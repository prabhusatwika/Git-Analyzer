# Application
APP_NAME=RepoMind AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
ENABLE_DOCS=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repomind

# Internal API secret (shared with frontend server actions)
INTERNAL_API_SECRET=change-me-in-production

# Cache
REDIS_URL=redis://localhost:6379/0
