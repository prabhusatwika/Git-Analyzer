# RepoMind AI — Root Environment Variables
# Copy to .env for local development (optional root-level overrides)

# Node environment
NODE_ENV=development

# Frontend URL (used by backend CORS)
FRONTEND_URL=http://localhost:3000

# Backend URL (used by frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application
APP_NAME=RepoMind AI
